# Comma-separated if you reach this dev server more than one way — a
# port-forward, the WSL/LAN IP, a phone on the same network. Any origin not
# listed here gets a silent 403 from every function below.
APP_ORIGIN=http://localhost:8788
YOUTUBE_API_KEY=replace_with_your_api_key

# One Home row per country. Unset, it is the listener's own country followed by
# US,GB,KR,BR — but locally Cloudflare reports its own edge, so pin yours here.
CHART_REGIONS=IN,US,GB,KR

# The extractor box (see extractor/). Without these, YouTube rows appear in
# search but will not play — everything else is unaffected.
EXTRACTOR_URL=http://localhost:8099
EXTRACTOR_TOKEN=replace_with_a_long_random_string

# Optional: a self-hosted Lyrica instance (github.com/Wilooper/Lyrica), tried
# before LRCLIB for every track regardless of which backend it streams from.
# Unset is fine — lyrics just come from LRCLIB alone, as before.
LYRICA_URL=http://localhost:9999
