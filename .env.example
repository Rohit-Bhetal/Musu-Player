# Firebase Web config — from Firebase Console > Project settings > General >
# Your apps > Web app > SDK setup and configuration > Config. These are NOT
# secret (they identify the project, not authorize access to it — Firestore's
# security rules do that), but a per-project default should not get committed,
# so put real values in .env.local (gitignored by the existing *.local rule).
#
# Unset entirely: Settings' "Back up playlists & history" row just does not
# appear, and the app behaves exactly as before — the same optional-backend
# pattern as EXTRACTOR_URL and LYRICA_URL in .dev.vars.example.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
