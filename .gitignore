node_modules
dist
dist-ssr
*.local
.dev.vars
.wrangler/
.DS_Store
.vite

# generated by scripts/gen-assets.mjs on predev/prebuild — never committed
public/icons/*
# the one exception: hand-saved, not generated — gen-assets.mjs doesn't write it
!public/icons/apple-touch-icon.png
public/mock/
dev-dist/

# tsc -b artifact, regenerated on every build
*.tsbuildinfo
.env

# Python bytecode cache — machine/version-specific, regenerated on run
__pycache__/

# local Claude Code agent state, not part of the app
.claude/

# a real YouTube account's session cookies — never committed
extractor/cookies.txt

# a real ProtonVPN account's WireGuard credentials — never committed
extractor/protonvpn*.conf
