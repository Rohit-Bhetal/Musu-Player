rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules (no CLI
// needed). Every document lives under users/{uid}/..., and a signed-in user
// may only read or write their own subtree — cloudSync.ts never addresses
// any other uid, so this is the only thing actually enforcing that.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
